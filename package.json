{
  "name": "Clarify Data Interface",
  "version": "1.0.0",
  "description": "An interface to collect clarify bot and sub-advisors data",
  "main": "app.js",
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.12.0",
    "@parcel/transformer-webmanifest": "^2.12.0",
    "parcel": "^2.12.0",
    "tailwindcss": "^3.4.4",
    "workbox-cli": "^7.1.0"
  },
  "scripts": {
    "build:css": "npx tailwindcss -i ./styles.css -o ./src/output.css --watch",
    "start": "parcel index.html",
    "build": "parcel build index.html",
    "generate-sw": "workbox generateSW workbox-config.js",
    "build:offline": "npm run build && npm run generateSW"
  },
  "dependencies": {
    "dom-to-image-more": "^3.3.0",
    "file-saver": "^2.0.5",
    "flatpickr": "^4.6.13"
  }
}
